{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.asiandoula.org"
        }
      ],
      "destination": "https://www.asiandoula.org/admin/login",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "admin.asiandoula.org"
        }
      ],
      "destination": "https://www.asiandoula.org/admin/login",
      "permanent": false
    }
  ]
}
